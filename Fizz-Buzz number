import java.util.Scanner;
class Main
{
	static Scanner sc=new Scanner(System.in);
	public static void main(String[]args)
	{
		System.out.println("Enter number:");
		int num=sc.nextInt();
		
		if (num%3==0 && num%5==0)
		{
			System.out.println("Entered Number is \"Fizz Buzz\"");
		}
		else if (num%3==0)
		{
			System.out.println("Entered Number is \"Fizz\"");
		}
		else if (num%5==0)
		{
			System.out.println("Entered Number is \"Buzz\"");
		}
		else
			System.out.println("Invalid Number");
		
	}
}

