class pattern
{
	public static void main(String[]args)
	{
		int n=5;
		for (int i=0;i<n;i++ )
		{
			char data='A';
			for (int j=0;j<n;j++ )
			{
				if (i%2==0)
				{
					System.out.print(data++ +" ");
				}
				else
					System.out.print(j+1+" ");
			}
			System.out.println();
		}
	}
}

