import java.util.Scanner;
class Main
{
	static Scanner sc=new Scanner(System.in);
	public static void main(String[]args)
	{	
		System.out.print("Enter number:");
		int num=sc.nextInt();
		
		int count=0;
		
		if (num==0)
		{
			count=1;
		}
		
		while (num>0)
		{
			num=num/10;
			count++;
		}
			
			System.out.println("Count of the digit:"+count);
	}
}

