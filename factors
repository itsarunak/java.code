import java.util.Scanner;
class factors
{
	static Scanner sc=new Scanner(System.in);
	public static void main(String[]args)throws Exception
	{
		System.out.println("number:");
		int num=sc.nextInt();
		
		for (int i=2;i<=num/2 ;i++ )
		{
			if (num%i==0)
			{
				System.out.println(" factors:"+i);
			}
		}
	}
}
