import java.util.Scanner;
class Main
{
	static Scanner sc=new Scanner(System.in);
	public static void main(String[]args)
	{
		System.out.println("**** Month-season ****");
		System.out.print("\nEnter Month number:");
		int month=sc.nextInt();
		
		
		if (month>=3 && month<=5)
		{
			System.out.println("\n-----------------\nSummer Season");
		}
		else if (month>=6 && month<=9)
		{
			System.out.println("\n-----------------\nWinter Season");
		}
		else if (month>=10 && month<=12 || month>=1 && month<=2)
		{
			System.out.println("\n-----------------\nRainy Season");
		}
		else
			System.out.println("\n-----------------\nInvalid month");
		
	}
}

