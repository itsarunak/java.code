import java.util.Scanner;
class Main
{
	static Scanner sc=new Scanner(System.in);
	public static void main(String[]args)
	{
		System.out.print("Enter number: ");
		int num=sc.nextInt();
		
		int last_digit=num%10;
		
		num=num/10;
		int sum=0;
		
		while (num>9)
		{
			sum+=num%10;
			num=num/10;
		}
		
		num+=last_digit;
		
		System.out.println((num==sum?"xylem":"phloem"));
	}
}
/*
Enter number: 21234
xylem
*/
