import java.util.Scanner;
class Main
{
	static Scanner sc=new Scanner(System.in);
	public static void main(String[]args)
	{
		System.out.print("Enter number: ");
		int num=sc.nextInt();
		
		int sum=0;
		
		while (num>0)
		{
			sum+=num%10;
			num=num/10;
		}
	
		System.out.println("Digital sum:"+ sum);
	}
}
