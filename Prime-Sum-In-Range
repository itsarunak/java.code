class PrimeSumInRange
{
	public static void main(String[]args)
	{
		int start=10;
		int end=20;
		
		int sum=0;
		
		
		for (int i=start;i<=end ;i++ )
		{
			if (i<=1)
			{
				continue;
			}
			boolean flag=true;
			for (int j=2;j<i ;j++ )
			{
				if (i%j==0)
				{
					flag=false;
					break;
				}
			}
			
			if (flag)
			{
				System.out.println(i);
				sum+=i;
			}
		}
		
		System.out.println("Sum of Prime number within a range:"+sum);
	}
}

