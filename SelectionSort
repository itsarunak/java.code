import java.util.Arrays;
class SelectionSort
{
	public static void main(String[]args)
	{
		int []a={6,5,2,8,9,4};
		
		
		int min=-1;
		
		
		for (int i=0;i<a.length-1 ;i++ )
		{
			min=i;
			
			for (int j=i+1;j<a.length ;j++ )
			{
				if (a[min]>a[j])
				{
					min=j;
				}
			}
			
			int temp=a[min];
			a[min]=a[i];
			a[i]=temp;
		}
		
		System.out.println(Arrays.toString(a));
	}
}
