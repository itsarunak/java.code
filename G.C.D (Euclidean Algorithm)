import java.util.Scanner;
class Main
{
	static Scanner sc=new Scanner(System.in);
	public static void main(String[]args)
	{
		System.out.println("Enter a:");
		int a=sc.nextInt();
		
		System.out.println("Enter b:");
		int b=sc.nextInt();
		
		a=Math.abs(a);
		b=Math.abs(b);
		
		while (b!=0)
		{
			int temp=b;
			b=a%b;
			a=temp;
		}
		
		System.out.println("Greatest Common Divisor is "+a);
	}
}
